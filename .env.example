# Copy values into your shell environment. The daemon does not load .env files.
HARNESS_BASE_URL=https://api.openai.com/v1
HARNESS_MODEL=gpt-4.1
HARNESS_API_KEY=

# Optional. Native execution is the default; demo mode performs synthetic work.
# Select demo mode explicitly in the desktop settings.
# HARNESS_DATA_DIR=/absolute/path/to/private/runtime-data
# HARNESS_BIND=127.0.0.1:47371

# Shell execution grants the task process your local user permissions.
# HARNESS_ALLOW_COMMANDS=1
